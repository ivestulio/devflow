# --- Azure OpenAI (modelo de raciocinio) ---
AZURE_OPENAI_ENDPOINT=https://<seu-recurso>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# ATENCAO: e o nome do DEPLOYMENT que voce criou no Azure AI Foundry,
# que nem sempre e igual ao nome do modelo.
AZURE_OPENAI_CHAT_DEPLOYMENT=

# --- Azure AI Search (base de conhecimento) ---
# O indice devflow-kb ja existe e e alimentado por um indexador de blob no portal.
# Nao ha deployment de embedding aqui de proposito: a vetorizacao e feita pelo
# proprio Azure AI Search (vetorizador integrado, text-embedding-3-small, 1536 dims),
# entao o DevFlow manda a consulta como TEXTO e nunca calcula embedding.
AZURE_SEARCH_ENDPOINT=https://<seu-servico>.search.windows.net
AZURE_SEARCH_INDEX=devflow-kb
AZURE_SEARCH_KEY=

# --- MLflow (observabilidade, opcional) ---
# Deixe VAZIO para rodar sem tracing. Preencha so depois de subir o servidor
# com `mlflow server --host 127.0.0.1 --port 5000`, senao o agente loga um
# aviso de conexao a cada subida (ele continua funcionando).
# Porta 5001, nao 5000: no macOS a 5000 e ocupada pelo AirPlay Receiver
# (ControlCenter), que responde 403 e faz parecer que ha um servidor no ar.
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=devflow
MLFLOW_ENABLE_ASYNC_TRACE_LOGGING=true
